# окружение и сборка
.venv/
__pycache__/
*.pyc
*.egg-info/
dist/
build/

# локальное состояние kurator: БД индексов и скачанные веса
# .kurator/ хранит относительные пути к снимкам, размеры, даты съёмки,
# md5, перцептивные хеши и 768-мерные эмбеддинги. Это метаданные о
# частных фотографиях, и им не место в репозитории.
# Карантин тоже лежит здесь: .kurator/quarantine/. Внутри — сами
# фотографии и манифесты переносов. Если kurator запустить на папке
# внутри git-репозитория, без этой строки снимки попадут в коммит
# целиком. Одна скрытая директория вместо двух.
.kurator/
*.kurator/

# карантин до переезда внутрь .kurator: на старых архивах папка
# могла остаться. Файлы оттуда уже переехали, но правило лишним не будет.
_kurator_quarantine/

# веса модели, 90 МБ — качаются скриптом
models/

# отчёты: названия файлов, даты, контакт-листы с превью
out/
report/

.DS_Store
